<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-versioned TFM (rather than plain net10.0-windows) is required to
         consume WinRT APIs such as Windows.Media.Ocr for the OCR feature. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SnipAgent</AssemblyName>
    <RootNamespace>SnipAgent.App</RootNamespace>
    <ApplicationIcon>Assets\capture.ico</ApplicationIcon>
    <!-- Allows restoring/building this Windows-targeted project on non-Windows dev/CI machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WFAC010/WFO0003 (renamed between .NET 8 and .NET 10) suggests setting
         high-DPI mode via WinForms' Application API instead of the manifest, but this
         is a WPF-primary app (WinForms is only used for the tray NotifyIcon/
         FolderBrowserDialog) that requires manifest-level Per-Monitor-V2 DPI awareness
         for its overlay windows; the manifest setting is intentional here. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnipAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray/window icon loaded at runtime via pack URI (see TrayIconManager). -->
    <Resource Include="Assets\capture.ico" />
    <!-- Built-in AI Skills prompt templates, deserialized at runtime by
         AiCaptureSettings.CreateDefaultAiSkills(). Embedded (rather than copied to the
         output folder) so the defaults are always available regardless of how the app
         is deployed. LogicalName is pinned so renaming the folder/root namespace can't
         silently break the lookup. -->
    <EmbeddedResource Include="Assets\default-ai-skills.json"
                      LogicalName="SnipAgent.App.Assets.default-ai-skills.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI capture feature: OpenAI-compatible chat client, Microsoft.Extensions.AI
         abstractions, and the MCP client for optional tool-calling in "Use AI to
         answer" mode. -->
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
  </ItemGroup>

</Project>
