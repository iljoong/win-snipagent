<Window x:Class="SnipAgent.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipAgent Settings" Width="560" Height="760"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="HotkeySaveErrorText" Foreground="Red" TextWrapping="Wrap"
                       Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Content="Save" Width="90" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Save Option -->
                <GroupBox Header="Save Option" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <TextBlock Text="Save folder:" Margin="0,0,0,2" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse..." Width="90" Margin="8,0,0,0" Click="OnBrowseFolderClick" />
                            <TextBox x:Name="SaveFolderTextBox" VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="File name pattern (.png always appended):" Margin="0,12,0,2" />
                        <TextBox x:Name="FilenamePatternTextBox" TextChanged="OnFilenamePatternTextChanged" />
                        <TextBlock x:Name="FilenamePreviewText" Margin="0,6,0,0" Foreground="Gray" />
                        <TextBlock Text="Tokens: {date}, {time}, {datetime}" Margin="0,2,0,0" FontSize="11" Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <!-- Capture Options -->
                <GroupBox Header="Capture Options" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <Label Content="Global hotkey (repeats last-used capture mode):" Margin="0,0,0,2"
                               Target="{Binding ElementName=HotkeyTextBox}" Padding="0" />
                        <TextBox x:Name="HotkeyTextBox" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                 AutomationProperties.Name="Global hotkey"
                                 Text="Click here and press a new key combination" />
                        <TextBlock x:Name="HotkeyValidationText" Margin="0,6,0,0" Foreground="Red" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Capture delay:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CaptureDelayComboBox" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Saving option:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SavingOptionComboBox" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Advanced Options -->
                <GroupBox Header="Advanced Options" Margin="0,0,0,12">
                    <TabControl Margin="8">
                        <TabItem Header="AI Capture">
                            <StackPanel Margin="8">
                                <ComboBox x:Name="ExtractMethodComboBox" Width="240" HorizontalAlignment="Left"
                                          SelectionChanged="OnExtractMethodSelectionChanged" />

                                <DockPanel x:Name="AiSkillsDockPanel" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="AI Skills (manage and preview; choose one in the answer overlay):"
                                                   Margin="0,0,0,2" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button x:Name="AiSkillsEditButton" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                        Width="28" Margin="0,0,4,0" ToolTip="Edit selected AI skills" Click="OnAiSkillsEditClick" />
                                                <Button x:Name="AiSkillsAddButton" Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                        Width="28" Margin="0,0,4,0" ToolTip="Add new AI skills" Click="OnAiSkillsAddClick" />
                                                <Button x:Name="AiSkillsDeleteButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                        Width="28" ToolTip="Delete selected AI skills" Click="OnAiSkillsDeleteClick" />
                                            </StackPanel>
                                            <ComboBox x:Name="AiSkillsComboBox" HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnAiSkillsSelectionChanged" />
                                        </DockPanel>

                                        <DockPanel Margin="0,12,0,2">
                                            <Button DockPanel.Dock="Right" x:Name="AiSkillsRestoreDefaultsButton" Content="Restore defaults"
                                                    Padding="6,2" ToolTip="Reset the AI skills list to the built-in defaults, discarding your additions and edits"
                                                    Click="OnAiSkillsRestoreDefaultsClick" />
                                            <TextBlock Text="Skills Prompt:" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBox x:Name="AiSkillsPromptTextBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                                 IsReadOnly="True" Background="#FFF0F0F0" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="AI Settings">
                            <StackPanel Margin="8">
                                <TextBlock Text="Base URL:" Margin="0,0,0,2" />
                                <TextBox x:Name="AiBaseUrlTextBox" />

                                <TextBlock Text="Model:" Margin="0,10,0,2" />
                                <TextBox x:Name="AiModelTextBox" />

                                <TextBlock Text="API Key:" Margin="0,10,0,2" />
                                <PasswordBox x:Name="AiApiKeyBox" />
                                <TextBlock x:Name="AiApiKeyHintText" Margin="0,2,0,0" FontSize="11" Foreground="Gray" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Custom Hotkey">
                            <StackPanel Margin="8">
                                <TextBlock Text="Click a field and press a key combination. Availability is checked on Save."
                                           TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10" />
                                <Label Target="{Binding ElementName=AiSkillsHotkeyTextBox}" Padding="0" Margin="0,0,0,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="AI Skills" FontWeight="SemiBold" />
                                        <Run Text=" &#x2014; Region capture" Foreground="#595959" />
                                    </TextBlock>
                                </Label>
                                <TextBox x:Name="AiSkillsHotkeyTextBox" IsReadOnly="True"
                                         AutomationProperties.Name="AI Skills hotkey"
                                         AutomationProperties.HelpText="Region capture using AI Skills."
                                         PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                                <TextBlock x:Name="AiSkillsHotkeyValidationText" Foreground="Red"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />

                                <Label Target="{Binding ElementName=ExtractTextHotkeyTextBox}"
                                       Padding="0" Margin="0,10,0,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Extract Text" FontWeight="SemiBold" />
                                        <Run Text=" &#x2014; Region capture using LLM" Foreground="#595959" />
                                    </TextBlock>
                                </Label>
                                <TextBox x:Name="ExtractTextHotkeyTextBox" IsReadOnly="True"
                                         AutomationProperties.Name="Extract Text hotkey"
                                         AutomationProperties.HelpText="Region capture with LLM text extraction."
                                         PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                                <TextBlock x:Name="ExtractTextHotkeyValidationText" Foreground="Red"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />

                                <Label Target="{Binding ElementName=FullScreenHotkeyTextBox}"
                                       Padding="0" Margin="0,10,0,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Full Screen" FontWeight="SemiBold" />
                                        <Run Text=" &#x2014; Image only" Foreground="#595959" />
                                    </TextBlock>
                                </Label>
                                <TextBox x:Name="FullScreenHotkeyTextBox" IsReadOnly="True"
                                         AutomationProperties.Name="Full Screen hotkey"
                                         AutomationProperties.HelpText="Monitor capture without text extraction or AI."
                                         PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                                <TextBlock x:Name="FullScreenHotkeyValidationText" Foreground="Red"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />

                                <Label Target="{Binding ElementName=RegionHotkeyTextBox}"
                                       Padding="0" Margin="0,10,0,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Region" FontWeight="SemiBold" />
                                        <Run Text=" &#x2014; Image only" Foreground="#595959" />
                                    </TextBlock>
                                </Label>
                                <TextBox x:Name="RegionHotkeyTextBox" IsReadOnly="True"
                                         AutomationProperties.Name="Region hotkey"
                                         AutomationProperties.HelpText="Region capture without text extraction or AI."
                                         PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                                <TextBlock x:Name="RegionHotkeyValidationText" Foreground="Red"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </GroupBox>

                <!-- Notes -->
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12"
                           Text="Note: SnipAgent does not start automatically with Windows. Screenshots are saved as PNG only. If the save folder becomes unavailable, captures automatically fall back to the Pictures\SnipAgent folder. The AI capture API key is stored securely in Windows Credential Manager, not in settings.json." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
